# FinOps Tool — copy to .env (chmod 600); placeholders only.
# Generate independent hex secrets with: openssl rand -hex 32
# Do not put AWS credentials in this file.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
# Signs dashboard sessions (min. 32 chars). Changing it signs everyone out.
AUTH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_HEX
# Session lifetime in hours.
SESSION_HOURS=12

# Web UI listener. 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the LAN.
# Postgres and the API always stay on 127.0.0.1.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
# Loopback host ports for Postgres and the API (change only if already in use).
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
# Set true only if users reach the UI over HTTPS (TLS reverse proxy).
COOKIE_SECURE=false

# Optional. Compose project name (prefixes containers and the DB volume).
COMPOSE_PROJECT_NAME=finops
AWS_REGION=us-east-1
# "scanner" runs scheduled scans of every verified account; empty disables them.
COMPOSE_PROFILES=
SCAN_INTERVAL_SECONDS=21600
# AWS credentials for the scanner (see docs/DEPLOY_DEBIAN.md §5). On EC2 with
# an instance role, leave these unset. On a normal Debian machine, mount a
# directory holding TEMPORARY credentials or an SSO profile:
# COMPOSE_FILE=docker-compose.yml:docker-compose.aws-profile.yml
# FINOPS_AWS_PROFILE=finops-scanner
# AWS_PROFILE_DIR=/home/<you>/.finops/aws
# HOST_UID=1000
# HOST_GID=1000
# Read on the host by scripts/refresh_scanner_credentials.sh only:
# SCANNER_ROLE_ARN=arn:aws:iam::111111111111:role/FinOps-Scanner
# SCANNER_SOURCE_PROFILE=<your operator profile>
# A signed-in user without a workspace may create one from the web.
ALLOW_TENANT_SIGNUP=true
# Only if the scanner role has a non-default IAM path (not needed for SSO):
# SOURCE_ROLE_ARN=arn:aws:iam::111111111111:role/path/vm-role

# Development-only: only for Python tools running OUTSIDE Docker.
# Containers construct their own URLs. Uncomment and fill in when needed.
# DATABASE_URL=postgresql+psycopg2://finops_app:REPLACE_WITH_APP_DB_PASSWORD@localhost:5432/finops
# ADMIN_DATABASE_URL=postgresql+psycopg2://finops:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/finops
